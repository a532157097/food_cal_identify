# Coze 开放平台个人访问令牌，只放在服务端，不要写进小程序
COZE_API_TOKEN=
# 已发布工作流的 workflow_id
COZE_WORKFLOW_ID=
# 工作流开始节点里图片参数的名字，需与画布一致
COZE_IMAGE_PARAM=image
# json_string：参数值是 "{\"file_id\":\"...\"}"；object：参数值是 {"file_id":"..."}
COZE_IMAGE_VALUE_STYLE=json_string
COZE_API_BASE=https://api.coze.cn
COZE_TIMEOUT_SECONDS=120
# 工作流耗时长时改为 1，服务会轮询执行结果
COZE_IS_ASYNC=0
# 设为 1 时不调用 Coze，返回固定示例，方便先看页面
COZE_MOCK=0
